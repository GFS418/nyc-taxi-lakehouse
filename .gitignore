# Python
.venv/
__pycache__/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Local data (the lake lives in GCS; local copies are disposable)
data/
scratch/

# Spark local artifacts
spark-warehouse/
metastore_db/
derby.log

# dbt
dbt/target/
dbt/logs/
dbt/dbt_packages/
dbt/.user.yml

# Terraform (commit .terraform.lock.hcl; never state or real tfvars)
infra/.terraform/
infra/*.tfstate
infra/*.tfstate.*
infra/terraform.tfvars

# Secrets
.env
*.env
*-key.json
credentials*.json
service-account*.json
